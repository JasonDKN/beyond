# Beyond — optional cloud transcription providers.
# The default provider (local Whisper) needs none of these.
#
# These are read at build time by Vite. Anything prefixed VITE_ is embedded in
# the client bundle, so only use them for local development. For anything
# public-facing, route the request through a server that holds the key.

VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

VITE_DEEPGRAM_API_KEY=
VITE_DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
