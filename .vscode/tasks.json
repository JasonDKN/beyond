{
  // Starts the dev server the moment this folder is opened, so the app is
  // already up by the time you go looking for it. VS Code asks once whether to
  // allow automatic tasks in a folder — say yes, or run it by hand from
  // Terminal > Run Task > "Beyond: dev server".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Beyond: dev server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
