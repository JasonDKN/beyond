{
  "name": "beyond",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beyond — transcribe songs into the International Phonetic Alphabet, word by word.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,css,html,json,md}\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "cmu-pronouncing-dictionary": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
